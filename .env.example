# انسخ هذا الملف إلى .env واملأ القيم. لا ترفع .env أبداً إلى GitHub.

# توكن بوت تليجرام (من @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAE...

# مفتاح Groq API (من https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# توكن GitHub صلاحيته repo (لرفع ملف الذاكرة)
GITHUB_TOKEN=ghp_...

# اسم المستودع بصيغة owner/repo
GITHUB_REPO=eo7w/BOT-22

# رابط التطبيق بعد النشر (بدون / في النهاية) — يضبط الويب هوك تلقائياً
WEBHOOK_URL=https://bot-22.onrender.com

# النموذج والمعاملات (اختياري)
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_REASONING_EFFORT=low
MAX_COMPLETION_TOKENS=2048

# عطّلها إلى false إذا كانت ذاكرة الخادم ضعيفة (تتخطى تحميل نموذج التضمين الثقيل)
EMBEDDINGS_ENABLED=true
